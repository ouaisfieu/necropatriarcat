  {
   "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/abandon-police/#concept",
   "@type": "skos:Concept",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Abandon policé"
    },
    {
     "@language": "en",
     "@value": "Policed abandonment"
    }
   ],
   "skos:definition": {
    "@language": "fr",
    "@value": "Mode de gouvernance combinant une surveillance et une répression accrues avec une exemption du devoir de protection : les personnes visées sont hyper-contrôlées et simultanément privées de recours."
   },
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/#scheme"
   },
   "foaf:page": "https://ouaisfieu.github.io/necropatriarcat/notions/abandon-police/",
   "skos:related": [
    {
     "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/injustice-epistemique/#concept"
    },
    {
     "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/vie-nue/#concept"
    },
    {
     "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/feminisme-carceral/#concept"
    },
    {
     "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/transfeminicide/#concept"
    }
   ]
  },
  {
   "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/biopolitique/#concept",
   "@type": "skos:Concept",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Biopolitique"
    },
    {
     "@language": "en",
     "@value": "Biopolitics"
    }
   ],
   "skos:definition": {
    "@language": "fr",
    "@value": "Rationalité de gouvernement qui s'exerce sur la population comme corps biologique : « faire vivre et laisser mourir », par la santé publique, la démographie, la norme et la discipline."
   },
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/#scheme"
   },
   "foaf:page": "https://ouaisfieu.github.io/necropatriarcat/notions/biopolitique/",
   "skos:related": [
    {
     "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/necropolitique/#concept"
    },
    {
