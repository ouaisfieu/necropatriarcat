     "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/extractivisme/#concept"
    },
    {
     "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/ecofeminisme/#concept"
    },
    {
     "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/feminisme-decolonial/#concept"
    }
   ]
  },
  {
   "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/debilitation/#concept",
   "@type": "skos:Concept",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Débilitation"
    },
    {
     "@language": "en",
     "@value": "Debility"
    }
   ],
   "skos:definition": {
    "@language": "fr",
    "@value": "Production délibérée de corps affaiblis, blessés ou chroniquement diminués, selon un vecteur qui n'est ni « faire mourir » ni « laisser vivre » mais « ne pas laisser mourir / ne pas faire mourir »."
   },
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/#scheme"
   },
   "foaf:page": "https://ouaisfieu.github.io/necropatriarcat/notions/debilitation/",
   "skos:broader": [
    {
     "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/necropolitique/#concept"
    }
   ],
   "skos:related": [
