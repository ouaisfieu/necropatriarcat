  {
   "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/politiques-post-mortem/#concept",
   "@type": "skos:Concept",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Politiques post-mortem"
    },
    {
     "@language": "en",
     "@value": "Postmortem / transmortem politics"
    }
   ],
   "skos:definition": {
    "@language": "fr",
    "@value": "Méthodologie politique du deuil : refuser que les corps des victimes soient effacés ou trivialisés, et transformer la mort infligée en interruption publique de l'anesthésie sociale."
   },
