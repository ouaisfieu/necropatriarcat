     "@language": "en",
     "@value": "Social reproduction"
    }
   ],
   "skos:definition": {
    "@language": "fr",
    "@value": "Ensemble des activités — gestation, soin, alimentation, entretien, éducation, travail affectif — qui produisent et renouvellent quotidiennement et générationnellement la force de travail, majoritairement gratuites ou sous-payées."
   },
