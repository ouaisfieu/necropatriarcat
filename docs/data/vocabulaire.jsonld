     "@value": "Necromasculinity"
    }
   ],
   "skos:definition": {
    "@language": "fr",
    "@value": "Modèle de masculinité politique qui fait de la capacité de destruction — militaire, budgétaire, migratoire, rhétorique — la preuve principale de compétence à gouverner."
   },
