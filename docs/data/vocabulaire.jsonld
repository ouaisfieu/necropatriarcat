     "@value": "Fratrie masculine"
    },
    {
     "@language": "en",
     "@value": "Masculine fratria"
    }
   ],
   "skos:definition": {
    "@language": "fr",
    "@value": "Corporation des pairs masculins devant laquelle la virilité doit être prouvée, qui exige une loyauté absolue et sanctionne l'empathie comme une trahison."
   },
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/#scheme"
