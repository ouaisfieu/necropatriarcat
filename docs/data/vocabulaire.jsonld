     "@language": "en",
     "@value": "Pax Neoliberalia"
    }
   ],
   "skos:definition": {
    "@language": "fr",
    "@value": "Analyse de la mondialisation néolibérale comme réorganisation — et non pacification — de la violence, produisant une division sexuelle et internationale du travail entre « hommes en armes » et « femmes de service »."
   },
   "skos:inScheme": {
