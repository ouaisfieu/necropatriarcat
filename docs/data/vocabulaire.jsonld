   }
  },
  {
   "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/extractivisme/#concept",
   "@type": "skos:Concept",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Extractivisme"
    },
    {
     "@language": "en",
     "@value": "Extractivism"
    }
   ],
   "skos:definition": {
    "@language": "fr",
    "@value": "Modèle de développement fondé sur l'extraction intensive de ressources naturelles destinées à l'exportation, qui traite le territoire comme un objet inerte et inépuisable."
   },
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/#scheme"
   },
