   }
  },
  {
   "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/contre-pedagogie/#concept",
   "@type": "skos:Concept",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Contre-pédagogie de la cruauté"
    },
    {
     "@language": "en",
     "@value": "Counter-pedagogy of cruelty"
    }
   ],
   "skos:definition": {
    "@language": "fr",
    "@value": "Programme en quatre axes visant à défaire l'apprentissage de l'insensibilité : contre-pédagogie du pouvoir, politisation de l'expérience des femmes, reconnaissance de la victimisation des hommes, primat du projet des liens sur le projet des choses."
   },
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/#scheme"
   },
   "foaf:page": "https://ouaisfieu.github.io/necropatriarcat/notions/contre-pedagogie/",
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "contra-pedagogía de la crueldad"
    }
   ],
   "skos:related": [
    {
     "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/pedagogie-de-la-cruaute/#concept"
    },
    {
     "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/mandat-de-masculinite/#concept"
    },
    {
     "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/politiques-post-mortem/#concept"
    },
    {
     "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/transfeminisme/#concept"
    }
   ]
  },
  {
   "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/controle-coercitif/#concept",
   "@type": "skos:Concept",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Contrôle coercitif"
    },
    {
     "@language": "en",
     "@value": "Coercive control"
    }
   ],
   "skos:definition": {
    "@language": "fr",
    "@value": "Ensemble de comportements coercitifs ou de contrôle, continus ou répétés, causant un dommage psychique : isolement, surveillance, régulation des actes quotidiens, humiliation, privation de ressources."
   },
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/#scheme"
   },
   "foaf:page": "https://ouaisfieu.github.io/necropatriarcat/notions/controle-coercitif/",
   "skos:related": [
    {
     "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/micro-souverain/#concept"
    },
    {
     "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/reproduction-sociale/#concept"
    },
    {
     "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/feminicide/#concept"
    }
   ]
  },
  {
   "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/corps-pour-le-capital/#concept",
   "@type": "skos:Concept",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Corps pour le capital"
    },
    {
     "@language": "en",
     "@value": "Bodies for capital"
    }
   ],
   "skos:definition": {
    "@language": "fr",
    "@value": "Statut commun de corps dont la valeur dépend entièrement de leur conformité à une grammaire économique et visuelle qu'ils n'ont pas écrite : ouvrière, victime, compagne parée."
   },
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/#scheme"
   },
   "foaf:page": "https://ouaisfieu.github.io/necropatriarcat/notions/corps-pour-le-capital/",
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "cuerpos para el capital"
    }
   ],
   "skos:broader": [
    {
     "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/capitalisme-gore/#concept"
    }
   ],
   "skos:related": [
