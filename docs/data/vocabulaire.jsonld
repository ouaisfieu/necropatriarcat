  },
  {
   "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/buchona/#concept",
   "@type": "skos:Concept",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Buchona"
    },
    {
     "@language": "en",
     "@value": "Buchona"
    }
   ],
   "skos:definition": {
    "@language": "fr",
    "@value": "Compagne ou aspirante compagne du narcotrafiquant dans le nord-ouest du Mexique, dont le corps chirurgicalement refait fonctionne comme démonstration publique de la capacité de dépense de l'homme."
   },
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/#scheme"
   },
   "foaf:page": "https://ouaisfieu.github.io/necropatriarcat/notions/buchona/",
