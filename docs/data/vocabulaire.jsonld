    },
    {
     "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/feminisme-carceral/#concept"
    }
   ]
  },
  {
   "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/ecofeminisme/#concept",
   "@type": "skos:Concept",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Écoféminisme"
    },
    {
     "@language": "en",
     "@value": "Ecofeminism"
    }
   ],
   "skos:definition": {
    "@language": "fr",
    "@value": "Courant qui relie la domination des femmes et l'exploitation de la nature ; dans sa version décoloniale et communautaire, il en fait un constat matériel plutôt qu'une affinité essentielle."
   },
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/#scheme"
   },
   "foaf:page": "https://ouaisfieu.github.io/necropatriarcat/notions/ecofeminisme/",
