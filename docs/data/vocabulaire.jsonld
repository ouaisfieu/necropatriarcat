   }
  },
  {
   "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/feminisme-carceral/#concept",
   "@type": "skos:Concept",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Féminisme carcéral"
    },
    {
     "@language": "en",
     "@value": "Carceral feminism"
    }
   ],
   "skos:definition": {
    "@language": "fr",
    "@value": "Courant qui confie à l'appareil pénal et policier la réponse aux violences de genre, au risque de renforcer des institutions qui frappent par ailleurs les populations les plus exposées."
   },
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/#scheme"
   },
   "foaf:page": "https://ouaisfieu.github.io/necropatriarcat/notions/feminisme-carceral/",
