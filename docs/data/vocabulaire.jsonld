     "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/capitalisme-gore/#concept"
    },
    {
     "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/reproduction-sociale/#concept"
    }
   ]
  },
  {
   "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/cuerpo-territorio/#concept",
   "@type": "skos:Concept",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Corps-territoire"
    },
    {
     "@language": "en",
     "@value": "Body-territory"
    }
   ],
   "skos:definition": {
    "@language": "fr",
    "@value": "Notion selon laquelle le corps est le premier territoire et le territoire un prolongement du corps : les atteintes à l'un et à l'autre relèvent d'une même logique d'extraction."
   },
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/#scheme"
   },
   "foaf:page": "https://ouaisfieu.github.io/necropatriarcat/notions/cuerpo-territorio/",
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "cuerpo-territorio"
    }
   ],
   "skos:related": [
