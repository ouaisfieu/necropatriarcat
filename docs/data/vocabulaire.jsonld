     "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/necro-empowerment/#concept"
    },
    {
     "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/corps-pour-le-capital/#concept"
    }
   ]
  },
  {
   "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/capitalisme-racial/#concept",
   "@type": "skos:Concept",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Capitalisme racial"
    },
    {
     "@language": "en",
     "@value": "Racial capitalism"
    }
   ],
   "skos:definition": {
    "@language": "fr",
    "@value": "Thèse selon laquelle le capitalisme ne s'est pas développé puis racialisé : il s'est constitué par la racialisation, l'esclavage et la colonisation, qui en sont des conditions et non des accidents."
   },
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/#scheme"
   },
   "foaf:page": "https://ouaisfieu.github.io/necropatriarcat/notions/capitalisme-racial/",
