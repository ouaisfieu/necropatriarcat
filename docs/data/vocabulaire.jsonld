     "@language": "en",
     "@value": "Microsovereign"
    }
   ],
   "skos:definition": {
    "@language": "fr",
    "@value": "Homme institué par l'ordre patriarcal comme souverain sur un périmètre restreint — foyer, atelier, quartier, guichet — et disposant, dans ce périmètre, du droit de contraindre, de mutiler et de faire mourir."
   },
