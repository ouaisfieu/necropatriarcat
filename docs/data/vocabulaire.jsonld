     "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/capitalisme-gore/#concept"
    }
   ]
  },
  {
   "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/capitalisme-gore/#concept",
   "@type": "skos:Concept",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Capitalisme gore"
    },
    {
     "@language": "en",
     "@value": "Gore capitalism"
    }
   ],
   "skos:definition": {
    "@language": "fr",
    "@value": "Régime économique dans lequel l'étape de la production est supprimée : le corps humain — séquestré, mutilé, démembré, tué — devient directement la marchandise et la source de profit."
   },
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/#scheme"
   },
   "foaf:page": "https://ouaisfieu.github.io/necropatriarcat/notions/capitalisme-gore/",
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "capitalismo gore"
    }
   ],
   "skos:broader": [
    {
     "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/necropolitique/#concept"
    }
   ],
   "skos:related": [
    {
