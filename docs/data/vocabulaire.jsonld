     "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/biopolitique/#concept"
    },
    {
     "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/violence-lente/#concept"
    },
    {
     "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/homonationalisme/#concept"
    }
   ]
  },
  {
   "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/diligence-raisonnable/#concept",
   "@type": "skos:Concept",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Diligence raisonnable renforcée"
    },
    {
     "@language": "en",
     "@value": "Enhanced due diligence"
    }
   ],
   "skos:definition": {
    "@language": "fr",
    "@value": "Obligation pour un État, lorsqu'il connaît l'existence d'un schéma systématique de violence de genre, de prévenir, enquêter et sanctionner — son inaction engageant sa responsabilité internationale."
   },
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/#scheme"
   },
   "foaf:page": "https://ouaisfieu.github.io/necropatriarcat/notions/diligence-raisonnable/",
   "skos:altLabel": [
    {
     "@language": "fr",
     "@value": "debida diligencia reforzada"
    }
   ],
   "skos:related": [
