   }
  },
  {
   "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/feminicide/#concept",
   "@type": "skos:Concept",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Féminicide"
    },
    {
     "@language": "en",
     "@value": "Femicide / feminicide"
    }
   ],
   "skos:definition": {
    "@language": "fr",
    "@value": "Meurtre d'une femme en raison de son genre. Dans l'acception forgée par Marcela Lagarde, le terme inclut l'impunité et la responsabilité de l'État qui laisse ces meurtres se produire et ne les poursuit pas."
   },
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/#scheme"
   },
   "foaf:page": "https://ouaisfieu.github.io/necropatriarcat/notions/feminicide/",
