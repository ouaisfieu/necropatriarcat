   "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/organized-abandonment/#concept",
   "@type": "skos:Concept",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Abandon organisé"
    },
    {
     "@language": "en",
     "@value": "Organized abandonment"
    }
   ],
   "skos:definition": {
    "@language": "fr",
    "@value": "Retrait délibéré des infrastructures, des services publics et de la protection de certains territoires et de certaines populations, produisant des vulnérabilités différenciées à la mort prématurée."
   },
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/#scheme"
   },
