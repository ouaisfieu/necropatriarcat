     "@language": "en",
     "@value": "Grievability"
    }
   ],
   "skos:definition": {
    "@language": "fr",
    "@value": "Qualité reconnue à une vie d'être digne d'être pleurée. Une vie non pleurable est une vie dont la perte ne produit ni deuil public, ni scandale, ni obligation."
   },
   "skos:inScheme": {
