  {
   "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/feminisme-decolonial/#concept",
   "@type": "skos:Concept",
   "skos:prefLabel": [
    {
     "@language": "fr",
     "@value": "Féminisme décolonial"
    },
    {
     "@language": "en",
     "@value": "Decolonial feminism"
    }
   ],
   "skos:definition": {
    "@language": "fr",
    "@value": "Courant qui analyse le genre comme une catégorie produite par la colonisation, et refuse un féminisme qui obtiendrait des droits pour certaines femmes au prix de l'exploitation des autres."
   },
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/necropatriarcat/notions/#scheme"
   },
   "foaf:page": "https://ouaisfieu.github.io/necropatriarcat/notions/feminisme-decolonial/",
